{
  "name": "ai-study",
  "private": true,
  "description": "Shortcuts for the 30-day LLM engineering plan",
  "scripts": {
    "fresh": "node scripts/study.mjs fresh",
    "setup": "node scripts/study.mjs setup",
    "reset": "node scripts/study.mjs reset",
    "doctor": "node scripts/study.mjs doctor",
    "plan": "claude \"/study-planner\"",
    "init": "claude \"/study-coach init curriculum/plan.md\"",
    "today": "claude \"/study-coach\"",
    "page": "(sleep 1 && open http://localhost:8000) & python3 -m http.server 8000",
    "dashboard": "node \".claude/skills/study-coach/scripts/dashboard.mjs\" .",
    "status": "node \".claude/skills/study-coach/scripts/dashboard.mjs\" . --brief",
    "save": "node \".claude/skills/study-coach/scripts/sync.mjs\" . --yes",
    "online": "claude \"/study-coach online\"",
    "coach": "claude",
    "py": "uv run python",
    "sync": "uv sync"
  }
}
